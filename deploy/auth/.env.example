# Copy to /mnt/mmcblk0p2/auth/.env on the Pi (gitignored).

# --- Pocket ID ---
POCKET_ID_APP_URL=https://auth.myalabor.ch
# openssl rand -base64 32
ENCRYPTION_KEY=

# --- OIDC client for oauth2-proxy (create in Pocket ID after /setup) ---
# Callback URLs: https://dashboard.myalabor.ch/oauth2/callback
#                https://einkaufen.myalabor.ch/oauth2/callback
OIDC_CLIENT_ID=alabor-gate
OIDC_CLIENT_SECRET=
# openssl rand -base64 32  (must decode to 16, 24, or 32 bytes)
OIDC_COOKIE_SECRET=
OIDC_ISSUER=https://auth.myalabor.ch

# Upstream apps via Docker host-gateway (services on the Pi loopback)
UPSTREAM_DASHBOARD=http://host.docker.internal:8790
UPSTREAM_EINKAUF=http://host.docker.internal:8791

HOST_DASHBOARD=dashboard.myalabor.ch
HOST_EINKAUF=einkaufen.myalabor.ch
