# Copy to .env.local for local dev / to Pi env for production.

# proxy = behind oauth2-proxy (prod); dev = local stub identity
AUTH_MODE=dev
ALLOW_DEV_SESSION=1
DEV_USER_ID=dev-user
DEV_DISPLAY_NAME=Dev User

# Comma-separated subjects (email or X-Forwarded-User) treated as admin
ADMIN_SUBJECTS=dev-user,tom@example.com

POCKET_ID_URL=https://auth.myalabor.ch
DASHBOARD_PUBLIC_URL=https://dashboard.myalabor.ch
OAUTH2_SIGN_OUT_URL=https://dashboard.myalabor.ch/oauth2/sign_out
# Pocket ID OIDC client must list DASHBOARD_PUBLIC_URL/ as Logout Callback URL

# App visibility: appId:* or appId:sub1|email2  (entries separated by ;)
# Empty = all catalog apps visible to every authenticated user
# APP_GRANTS=einkaufsliste:*;lumito:*;alabors-drive:*;apple-anki:dev-user;mininotes:dev-user;server-manager:*

# App URLs — no pair/device tokens in these values
# EINKAUF_URL=https://einkaufen.myalabor.ch/
LUMITO_URL=http://192.168.1.172:8080/
ALABORS_DRIVE_URL=https://auto.myalabor.ch/web/drive.html
ANKI_LERN_URL=https://anki-lern.myalabor.ch/
NOTES_URL=https://notes.myalabor.ch/
SERVER_MANAGER_URL=https://server.myalabor.ch/

HOST=127.0.0.1
HOSTNAME=127.0.0.1
PORT=8790
