# Copy to .env.local for local dev / to Pi env for production.

SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ALLOW_DEV_SESSION=1

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
SETUP_BOOTSTRAP_SECRET=change-me-bootstrap-once

# SQLite (default: ./data/dashboard.db)
# DATABASE_PATH=/mnt/mmcblk0p2/dashboard-data/dashboard.db

# App URLs
# EINKAUF_URL=https://einkaufen.myalabor.ch/your-token
LUMITO_URL=http://192.168.1.172:8080/
ALABORS_DRIVE_URL=https://auto.myalabor.ch/web/drive.html
ANKI_LERN_URL=https://anki-lern.myalabor.ch/

HOST=127.0.0.1
HOSTNAME=127.0.0.1
PORT=8790
